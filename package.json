{
  "name": "bearuang",
  "private": true,
  "packageManager": "bun@1.3.11",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "dev:backend": "turbo run dev --filter=backend",
    "dev:frontend": "turbo run dev --filter=frontend",
    "start": "turbo run start",
    "build": "turbo run build",
    "build:backend": "turbo run build --filter=backend",
    "build:frontend": "turbo run build --filter=frontend",
    "check": "turbo run check",
    "check:backend": "turbo run check --filter=backend",
    "check:frontend": "turbo run check --filter=frontend",
    "lint": "turbo run lint",
    "format": "turbo run format",
    "test": "turbo run test",
    "db:generate": "turbo run db:generate --filter=backend",
    "db:migrate": "turbo run db:migrate --filter=backend",
    "db:push": "turbo run db:push --filter=backend",
    "db:studio": "turbo run db:studio --filter=backend",
    "db:seed": "turbo run db:seed --filter=backend",
    "db:validate": "turbo run db:validate --filter=backend"
  },
  "devDependencies": {
    "turbo": "^2.5.0"
  },
  "overrides": {
    "@tanstack/query-core": "5.95.2"
  },
  "dependencies": {
    "@tanstack/query-async-storage-persister": "^5.96.2",
    "@tanstack/react-query-persist-client": "^5.96.2"
  }
}
