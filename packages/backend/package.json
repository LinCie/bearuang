{
  "name": "backend",
  "version": "1.0.50",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "dev": "bun run --watch src/index.ts",
    "db:generate": "bunx --bun prisma generate",
    "db:migrate": "bunx --bun prisma migrate dev",
    "db:migrate:deploy": "bunx --bun prisma migrate deploy",
    "db:push": "bunx --bun prisma db push",
    "db:pull": "bunx --bun prisma db pull",
    "db:studio": "bunx --bun prisma studio",
    "db:seed": "bunx --bun prisma db seed",
    "db:reset": "bunx --bun prisma migrate reset",
    "db:validate": "bunx --bun prisma validate"
  },
  "dependencies": {
    "@better-auth/api-key": "^1.5.5",
    "@prisma/adapter-pg": "^7.5.0",
    "@prisma/client": "^7.5.0",
    "better-auth": "^1.5.5",
    "elysia": "latest"
  },
  "devDependencies": {
    "bun-types": "latest",
    "prisma": "^7.5.0"
  },
  "module": "src/index.js"
}
