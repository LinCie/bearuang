{
  "name": "backend",
  "version": "1.0.50",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "dev": "bun run --watch src/index.ts | bunx pino-pretty",
    "db:generate": "bunx --bun prisma generate",
    "db:migrate": "bunx --bun prisma migrate dev",
    "db:migrate:deploy": "bunx --bun prisma migrate deploy",
    "db:push": "bunx --bun prisma db push",
    "db:pull": "bunx --bun prisma db pull",
    "db:studio": "bunx --bun prisma studio",
    "db:seed": "bunx --bun prisma db seed",
    "db:reset": "bunx --bun prisma migrate reset",
    "db:validate": "bunx --bun prisma validate"
  },
  "dependencies": {
    "@better-auth/api-key": "^1.5.5",
    "@elysiajs/cors": "^1.4.1",
    "@elysiajs/openapi": "^1.4.14",
    "@prisma/adapter-pg": "^7.5.0",
    "@prisma/client": "^7.5.0",
    "better-auth": "^1.5.5",
    "elysia": "latest",
    "pino": "^10.3.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "bun-types": "latest",
    "prisma": "^7.5.0"
  },
  "module": "src/index.js",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./src/*": {
      "types": "./src/*.ts",
      "import": "./src/*.ts"
    }
  }
}
