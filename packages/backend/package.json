{
  "name": "backend",
  "version": "1.0.50",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "dev": "bun run --watch src/index.ts | bunx pino-pretty",
    "build": "bun build --compile --minify-whitespace --minify-syntax --target bun --outfile dist/server src/index.ts",
    "build:bundle": "bun build --minify-whitespace --minify-syntax --target bun --outfile dist/index.js src/index.ts",
    "start": "NODE_ENV=production ./dist/server",
    "start:bundle": "NODE_ENV=production bun dist/index.js",
    "db:generate": "bunx --bun prisma generate",
    "db:migrate": "bunx --bun prisma migrate dev",
    "db:migrate:deploy": "bunx --bun prisma migrate deploy",
    "db:push": "bunx --bun prisma db push",
    "db:pull": "bunx --bun prisma db pull",
    "db:studio": "bunx --bun prisma studio",
    "db:seed": "bunx --bun prisma db seed",
    "db:reset": "bunx --bun prisma migrate reset",
    "db:validate": "bunx --bun prisma validate",
    "lint": "eslint",
    "format": "prettier --check .",
    "check": "prettier --write . && eslint --fix && tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1018.0",
    "@aws-sdk/s3-request-presigner": "^3.1018.0",
    "@better-auth/api-key": "^1.5.5",
    "@elysiajs/cors": "^1.4.1",
    "@elysiajs/openapi": "^1.4.14",
    "@prisma/adapter-pg": "^7.5.0",
    "@prisma/client": "^7.5.0",
    "better-auth": "^1.5.5",
    "elysia": "latest",
    "pino": "^10.3.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "bun-types": "latest",
    "eslint": "^10.1.0",
    "prettier": "^3.8.1",
    "prisma": "^7.5.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.57.2"
  },
  "module": "src/index.js",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./src/*": {
      "types": "./src/*.ts",
      "import": "./src/*.ts"
    }
  }
}
